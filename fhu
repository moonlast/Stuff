local function getCoins()
    local container = workspace:FindFirstChild("CoinContainer", true)
    if not container then return {} end
    local coins = {}
    for _, child in ipairs(container:GetChildren()) do
        if child:IsA("BasePart") and child:GetAttribute("Collected") ~= true then
            table.insert(coins, child)
        end
    end
    return coins
end

local function findDroppedGun()
    for _, d in ipairs(workspace:GetChildren()) do
        if d:IsA("BasePart") and d.Name == "GunDrop" then return d end
        if d:IsA("Model") then
            local g = d:FindFirstChild("GunDrop")
            if g and g:IsA("BasePart") then return g end
        end
    end
    for _, p in ipairs(CollectionService:GetTagged("GunDrop")) do
        if p:IsA("BasePart") and p:IsDescendantOf(workspace) then return p end
    end
    return nil
end

local function findWeapon(name)
    local ch = LocalPlayer.Character
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
    return (ch and ch:FindFirstChild(name)) or (bp and bp:FindFirstChild(name))
end

local function roleOf(plr)
    local ch = plr.Character
    if ch then
        for _, t in ipairs(ch:GetChildren()) do
            if t:IsA("Tool") then
                if t.Name == "Knife" or t:FindFirstChild("Events") then return "Murderer" end
                if t.Name == "Gun" or t:FindFirstChild("Shoot") then return "Sheriff" end
            end
        end
    end
    return "Innocent"
end

local function alive(plr)
    local ch = plr.Character
    local hum = ch and ch:FindFirstChildOfClass("Humanoid")
    return ch and hum and hum.Health > 0 and getHRP(ch)
end

local function tpTo(pos)
    local hrp = getHRP(LocalPlayer.Character)
