task.spawn(function()
    while screenGui.Parent do
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                local ch = p.Character
                if flags.espNames and alive(p) and ch then
                    local hrp = getHRP(ch)
                    if hrp then
                        if not espStore[p] then
                            local hl = Instance.new("Highlight")
                            hl.Name = "ESP"
                            hl.FillTransparency = 1
                            hl.OutlineTransparency = 0
                            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                            hl.Parent = screenGui
                            
                            local bb = Instance.new("BillboardGui")
                            bb.Size = UDim2.fromOffset(160, 16)
                            bb.AlwaysOnTop = true
                            bb.StudsOffsetWorldSpace = Vector3.new(0, 3, 0)
                            bb.Parent = screenGui
                            
                            local lbl = Instance.new("TextLabel")
                            lbl.BackgroundTransparency = 1
                            lbl.Size = UDim2.fromScale(1, 1)
                            lbl.Font = Enum.Font.GothamBold
                            lbl.TextSize = 10
                            lbl.TextStrokeTransparency = 0.4
                            lbl.Parent = bb
                            
                            espStore[p] = {hl = hl, bb = bb, lbl = lbl}
                        end
                        
                        local e = espStore[p]
                        local role = roleOf(p)
                        local color = role == "Murderer" and Color3.fromRGB(255, 80, 80) or 
                                     (role == "Sheriff" and Color3.fromRGB(90, 150, 255) or Color3.fromRGB(95, 225, 125))
                        
                        if flags.espChams then
                            e.hl.Adornee = ch
                            e.hl.Enabled = true
                            e.hl.OutlineColor = color
                            e.hl.FillColor = color
                            e.hl.FillTransparency = flags.espFill and 0.6 or 1
                        else
                            e.hl.Enabled = false
                        end
                        
                        e.bb.Adornee = hrp
                        e.bb.Enabled = true
                        local myHrp = getHRP(LocalPlayer.Character)
                        local dist = myHrp and math.floor((hrp.Position - myHrp.Position).Magnitude) or 0
                        local tag = flags.espRoleTags and (role == "Murderer" and "[M] " or role == "Sheriff" and "[S] " or "[I] ") or ""
                        e.lbl.Text = tag .. p.Name .. "  " .. dist .. "m"
                        e.lbl.TextColor3 = color
                    end
                elseif espStore[p] then
                    espStore[p].hl:Destroy()
                    espStore[p].bb:Destroy()
                    espStore[p] = nil
                end
            end
        end
        task.wait(0.1)
    end
end)

-- Auto Coins
task.spawn(function()
    while screenGui.Parent do
        if flags.autoCoins and alive(LocalPlayer) then
            local hrp = getHRP(LocalPlayer.Character)
            if hrp then
                local coins = getCoins()
                local best, bd
                for _, c in ipairs(coins) do
                    local d = (c.Position - hrp.Position).Magnitude
                    if d < 250 and (not bd or d < bd) then
                        bd, best = d, c
                    end
                end
                if best then
                    local dir = best.Position - hrp.Position
                    if dir.Magnitude > 2 then
                        hrp.CFrame = CFrame.new(hrp.Position + dir.Unit * math.min(dir.Magnitude, 16 * 0.1))
                        hrp.AssemblyLinearVelocity = Vector3.zero
                    end
                end
            end
        end
        task.wait(0.05)
    end
end)

