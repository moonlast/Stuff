function rejoin()
    notify("Rejoining...")
    pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer) end)
end

function serverHop()
    notify("Finding server...")
    pcall(function()
        local servers = {}
        local cursor = nil
        for _ = 1, 3 do
            local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Desc&limit=100"
            if cursor then url = url .. "&cursor=" .. HttpService:UrlEncode(cursor) end
            local res = game:HttpGet(url)
            local data = HttpService:JSONDecode(res)
            if data and data.data then
                for _, sv in ipairs(data.data) do
                    if sv.id and sv.id ~= game.JobId and (sv.playing or 0) < (sv.maxPlayers or 0) then
                        table.insert(servers, sv)
                    end
                end
                cursor = data.nextPageCursor
                if not cursor then break end
            end
        end
        if #servers > 0 then
            local pick = servers[math.random(1, #servers)]
            pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId, pick.id, LocalPlayer) end)
        end
    end)
end

